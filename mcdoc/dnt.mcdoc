use::java::util::text::Text

struct Asnbt{
    source?: any,
    tokens?: [Text],
    token?: Text,
    previous?: Text,
    parts?: [string],
    path?: [string],
    segments?: [string],
    stack?: [any],
    frame?: any,
    failed?: boolean,
    key_remaining?: string,
    char?: string,
    array?: any,
    element?: string,
    macro?: struct{
        key?: string,
        path?: string,
        index?: int,
    },
}

struct Pcat{
    seg?: [Segment],
    raw?: [string],
    concat?: struct{
        [any]: string,
    },
    remainder?: [string],
    count?: int,
}

struct Segment{
    value?: string,
    is_single?: true,
}

dispatch minecraft:storage["dnt:ram"] to struct{
    asnbt?: Asnbt,
    asnbt_test?: any,
    in?: any,
    out?: string,
    char?: string @ 1,
    space?: string,
    new_line?: string,
    indent?: string,
    text?: Text,
    pt?: [Text],
    brackets?: [enum(string){square = "[",curly = "{",quote = "\"",single = "'"}],
    result?: [string],
    provided?: string,
    concat?: struct{
        escape?: string,
        in?: [string],
        count?: int,
    },
    temp?: any,
    holder?: any,
    sys?: struct{
        version?: int,
        VersionName?: string,
        MCVersionRange?: string,
        pong__?: boolean
    },
    args?: any,
    d_e?: string,
    pcat?: Pcat,
    "string"?: string,
    pcat_groups?: [string],
    backup?: any,
}
